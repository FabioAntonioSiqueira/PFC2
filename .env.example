# PFC2 — Configuração do Banco de Dados PostgreSQL
# Copie este arquivo para .env e preencha com as credenciais
# (as mesmas do .env do projeto PFC)
# NUNCA commite o arquivo .env no git
# ═══════════════════════════════════════════════════════════

# O banco é acessado pelo túnel SSH (ver README do PFC), por isso host/porta locais.
PGHOST=localhost
PGPORT=5433
PGDATABASE=solarufg
PGUSER=
PGPASSWORD=
